# Copia deste arquivo vive em ~/openwa/.env na VPS cerebro (umask 077).
# NUNCA commitar o .env real — a chave mestra fica só no servidor.

# Chave de admin da API e do painel. Gerar com: openssl rand -hex 32
API_MASTER_KEY=

# Traefik roda em network host e conecta via loopback
TRUSTED_PROXIES=127.0.0.1

# Religa sessões já pareadas após restart/reboot
AUTO_START_SESSIONS=true

# Opt-in: governor anti-ban (warmup + cap diário) — ligar antes de qualquer automação de disparo
# SEND_PACING_ENABLED=true
